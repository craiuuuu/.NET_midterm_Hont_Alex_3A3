### Variables
@baseUrl = http://localhost:5090

### 1. Create room
# @name createRoom
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "Study room 1",
  "capacity": 10
}

###
@roomId = {{createRoom.response.body.$.id}}

### 2. Get room
GET {{baseUrl}}/api/rooms/{{roomId}}

### 3. Get a missing room (expected: 404)
GET {{baseUrl}}/api/rooms/00000000-0000-0000-0000-000000000001

### 4. Create booking (change the dates to the future!)
# @name createBooking
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "ana",
  "startUtc": "2030-01-10T10:00:00Z",
  "endUtc": "2030-01-10T12:00:00Z",
  "attendees": 4
}

###
@bookingId = {{createBooking.response.body.$.id}}

### 5. Get booking
GET {{baseUrl}}/api/bookings/{{bookingId}}

### 6. Overlapping booking (expected: 409)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "bogdan",
  "startUtc": "2030-01-10T11:00:00Z",
  "endUtc": "2030-01-10T13:00:00Z",
  "attendees": 4
}

### 7. Cancel booking
POST {{baseUrl}}/api/bookings/{{bookingId}}/cancel

### 8. Cancel again (expected: 409, R8)
POST {{baseUrl}}/api/bookings/{{bookingId}}/cancel

### 9. Same interval after cancel (expected: 201, R8 frees the interval)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "bogdan",
  "startUtc": "2030-01-10T10:00:00Z",
  "endUtc": "2030-01-10T12:00:00Z",
  "attendees": 4
}

### 10. Touching interval (expected: 201, R7: 12:00-13:00 touches 10:00-12:00)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "carmen",
  "startUtc": "2030-01-10T12:00:00Z",
  "endUtc": "2030-01-10T13:00:00Z",
  "attendees": 2
}

### 11. Exactly 4 hours (expected: 201, R6)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "dan",
  "startUtc": "2030-01-11T08:00:00Z",
  "endUtc": "2030-01-11T12:00:00Z",
  "attendees": 2
}

### 12. More than 4 hours (expected: 400, R6)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "dan",
  "startUtc": "2030-01-12T08:00:00Z",
  "endUtc": "2030-01-12T12:00:01Z",
  "attendees": 2
}

### 13. In the past (expected: 400, R5)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "dan",
  "startUtc": "2020-01-10T10:00:00Z",
  "endUtc": "2020-01-10T11:00:00Z",
  "attendees": 2
}

### 14. Attendees over capacity (expected: 400, R4)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "dan",
  "startUtc": "2030-01-13T10:00:00Z",
  "endUtc": "2030-01-13T11:00:00Z",
  "attendees": 11
}

### 15. End before start (expected: 400, R3)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "dan",
  "startUtc": "2030-01-13T11:00:00Z",
  "endUtc": "2030-01-13T10:00:00Z",
  "attendees": 2
}

### 16. Missing bookedBy (expected: 400, R2)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "  ",
  "startUtc": "2030-01-14T10:00:00Z",
  "endUtc": "2030-01-14T11:00:00Z",
  "attendees": 2
}

### 17. Booking on a missing room with invalid body (expected: 404 before validation)
POST {{baseUrl}}/api/rooms/00000000-0000-0000-0000-000000000001/bookings
Content-Type: application/json

{
  "bookedBy": "",
  "startUtc": "2030-01-14T10:00:00Z",
  "endUtc": "2030-01-14T09:00:00Z",
  "attendees": 0
}

### 18. Invalid room (expected: 400, R1)
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "",
  "capacity": 0
}

### 19. Cancel missing booking (expected: 404)
POST {{baseUrl}}/api/bookings/00000000-0000-0000-0000-000000000001/cancel

### ---------- R9: max 2 active bookings per person per UTC day ----------

### 20. Second room
# @name createRoom2
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "Study room 2",
  "capacity": 6
}

###
@roomId2 = {{createRoom2.response.body.$.id}}

### 21. elena #1 on 2030-02-01, room 1 (expected: 201)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "elena",
  "startUtc": "2030-02-01T08:00:00Z",
  "endUtc": "2030-02-01T09:00:00Z",
  "attendees": 2
}

### 22. elena #2 same day, room 2 (expected: 201)
# @name elena2
POST {{baseUrl}}/api/rooms/{{roomId2}}/bookings
Content-Type: application/json

{
  "bookedBy": "elena",
  "startUtc": "2030-02-01T10:00:00Z",
  "endUtc": "2030-02-01T11:00:00Z",
  "attendees": 2
}

###
@elena2Id = {{elena2.response.body.$.id}}

### 23. elena #3 same day, room 2 (expected: 409, R9)
POST {{baseUrl}}/api/rooms/{{roomId2}}/bookings
Content-Type: application/json

{
  "bookedBy": "elena",
  "startUtc": "2030-02-01T14:00:00Z",
  "endUtc": "2030-02-01T15:00:00Z",
  "attendees": 2
}

### 24. elena on another day (expected: 201)
POST {{baseUrl}}/api/rooms/{{roomId2}}/bookings
Content-Type: application/json

{
  "bookedBy": "elena",
  "startUtc": "2030-02-02T14:00:00Z",
  "endUtc": "2030-02-02T15:00:00Z",
  "attendees": 2
}

### 25. Cancel elena #2
POST {{baseUrl}}/api/bookings/{{elena2Id}}/cancel

### 26. elena #3 again after cancel (expected: 201, cancelled ones do not count)
POST {{baseUrl}}/api/rooms/{{roomId2}}/bookings
Content-Type: application/json

{
  "bookedBy": "elena",
  "startUtc": "2030-02-01T14:00:00Z",
  "endUtc": "2030-02-01T15:00:00Z",
  "attendees": 2
}

### ---------- R10: capacity > 10 => max 2 hours ----------

### 27. Large room (capacity 20)
# @name createBigRoom
POST {{baseUrl}}/api/rooms
Content-Type: application/json

{
  "name": "Big room",
  "capacity": 20
}

###
@bigRoomId = {{createBigRoom.response.body.$.id}}

### 28. Exactly 2 hours in large room (expected: 201)
POST {{baseUrl}}/api/rooms/{{bigRoomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "florin",
  "startUtc": "2030-03-01T08:00:00Z",
  "endUtc": "2030-03-01T10:00:00Z",
  "attendees": 15
}

### 29. 3 hours in large room (expected: 400, R10)
POST {{baseUrl}}/api/rooms/{{bigRoomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "george",
  "startUtc": "2030-03-01T12:00:00Z",
  "endUtc": "2030-03-01T15:00:00Z",
  "attendees": 15
}

### 30. 3 hours in room with capacity 10 (expected: 201, R6 still 4h)
POST {{baseUrl}}/api/rooms/{{roomId}}/bookings
Content-Type: application/json

{
  "bookedBy": "george",
  "startUtc": "2030-03-01T12:00:00Z",
  "endUtc": "2030-03-01T15:00:00Z",
  "attendees": 5
}

### ---------- R11: cancel only >= 60 minutes before start ----------
# Change startUtc/endUtc to ~30 minutes from NOW (UTC!) before running 31.

### 31. Booking that starts in ~30 minutes
# @name soonBooking
POST {{baseUrl}}/api/rooms/{{roomId2}}/bookings
Content-Type: application/json

{
  "bookedBy": "ioana",
  "startUtc": "2026-11-19T08:15:00Z",
  "endUtc": "2026-11-19T08:45:00Z",
  "attendees": 2
}

###
@soonId = {{soonBooking.response.body.$.id}}

### 32. Cancel it (expected: 409, R11)
POST {{baseUrl}}/api/bookings/{{soonId}}/cancel
